    out.println("<h2>Please fill all fields.</h2>");
    return;
}
int eno = Integer.parseInt(enoStr);
int age = Integer.parseInt(ageStr);
double salary = Double.parseDouble(salaryStr);
Connection con = null;
PreparedStatement ps = null;
try {
    Class.forName("com.mysql.cj.jdbc.Driver");
    con = DriverManager.getConnection(
        "jdbc:mysql://localhost:3306/company?useSSL=false&serverTimezone=UTC",
        "root",
        "Priti@0103"
    );
    String sql = "UPDATE employee SET name=?, age=?, designation=?, salary=? WHERE eno=?";
    ps = con.prepareStatement(sql);
    ps.setString(1, name);
    ps.setInt(2, age);
    ps.setString(3, designation);
    ps.setDouble(4, salary);
    ps.setInt(5, eno);
    int rows = ps.executeUpdate();
    if(rows > 0){
