        eT.commit();
    } catch (RuntimeException e) {
        if (eT != null && eT.isActive()) {
            eT.rollback();
        }
        throw e;
    }
}
inventoryList =
        eM.createQuery("SELECT i FROM Inventory i",
                       Inventory.class)
          .getResultList();
eM.close();
%>
