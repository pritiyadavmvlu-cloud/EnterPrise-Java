SQL Command:
drop table registration;
CREATE TABLE registration (
    id NUMBER PRIMARY KEY,
    name VARCHAR2(50),
    email VARCHAR2(100),
    course VARCHAR2(100),
    phone VARCHAR2(20)
);
drop SEQUENCE registration_seq;
CREATE SEQUENCE registration_seq
START WITH 1
INCREMENT BY 1;
DESC registration;
SELECT * FROM registration;
